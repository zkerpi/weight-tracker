/* 全局设计令牌 —— 暖米底 + 深绿主色 + 衬线标题 */

page {
  --bg:#f0ede4; --surface:#fbf9f3; --surface-soft:#f1eee4;
  --text:#1c241e; --muted:#8a9086; --faint:#a9afa4; --line:#e7e3d7;
  --text-soft:#6d746a;
  --primary:#2f4b39; --primary-dark:#26402f; --primary-soft:#e7ede1;
  --accent:#c79064; --danger:#b45b44;
  /* 数字专用色：比正文略浅一点，衬线粗体在纯黑下会发闷 */
  --figure:#1a221c;
  background:var(--bg); color:var(--text);
  font-family:-apple-system, "PingFang SC", "Helvetica Neue", "Noto Sans CJK SC", sans-serif;
  font-size:28rpx; line-height:1.5;
}
view,text,button,input,textarea,image { box-sizing:border-box; }
button::after { border:none; }
button[disabled] { opacity:.45; }

/* 全站统一左右边距：所有页面的标题左边缘必须落在同一条竖线上 */
.page { min-height:100vh; padding:12rpx 40rpx calc(150rpx + env(safe-area-inset-bottom)); }

/* ---------- 页面标题 ----------
   2 字（今天/小组/排行/趋势）与 4 字（目标体重/体重单位/我的小组）用同一套字号，
   4 字只做 -7% 的光学补偿并收紧字距：等字号下 4 字横向占宽翻倍，
   会和下方副标题挤成同样宽的方块，主次就塌了。 */
.display-title {
  display:block; color:var(--text);
  font-family:"Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", Georgia, serif;
  font-size:56rpx; font-weight:400; letter-spacing:3rpx; line-height:1.04;
}
.display-title.long { font-size:52rpx; letter-spacing:2rpx; }

/* 页头：标题 + 副标题，右侧可放日期 / 图标按钮 */
.page-head { display:flex; align-items:flex-start; justify-content:space-between; }
.page-head-copy { display:flex; flex-direction:column; min-width:0; }
.page-tagline { margin-top:12rpx; color:var(--text-soft); font-size:23rpx; letter-spacing:.4rpx; line-height:1.4; }
.eyebrow { display:block; margin-bottom:8rpx; color:var(--muted); font-size:20rpx; letter-spacing:2rpx; }

/* ---------- 数字系统 ----------
   规则：被「称量」的数字（体重、公斤数、百分比）用衬线粗体；
        被「计数」的数字（天数、次数、日期、涨跌）留在无衬线里，加等宽数字。
   全站只有这一处定义数字字体，任何页面都不要再写 Arial / 默认 sans 的大数字。 */
.fig-num {
  font-family:"Playfair Display", "Didot", "Bodoni 72", Georgia,
              "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", serif;
  font-weight:700; font-size:1em; line-height:1; letter-spacing:0;
  font-variant-numeric:lining-nums tabular-nums; color:var(--figure);
}
/* 数字 + 单位：容器给字号，数字 1em；单位用固定 20rpx ——
   单位是「读得清的注脚」，不是等比缩放的装饰：跟着数字等比缩，
   到 32rpx 的数字时「斤」只剩 6px，谁都看不清。主数字（圆环/输入框）另行放大。 */
.fig-row { display:flex; align-items:baseline; }
.fig-unit {
  margin-left:.14em; color:var(--muted);
  font-family:"Playfair Display", "Didot", "Bodoni 72", Georgia,
              "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", serif;
  font-size:20rpx; font-weight:500; line-height:1; letter-spacing:0;
}
/* 句子里夹的体重数字（如「现在 120.6 斤」） */
.fig-inline {
  font-family:"Playfair Display", "Didot", "Bodoni 72", Georgia,
              "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", serif;
  font-weight:600; font-variant-numeric:lining-nums tabular-nums;
}
.tabular { font-variant-numeric:tabular-nums; }

.card { margin-bottom:22rpx; padding:28rpx; border:1rpx solid var(--line); border-radius:26rpx; background:var(--surface); }
.row-between,.section-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.section-title { color:var(--text); font-size:27rpx; font-weight:650; }
.small-label { color:var(--muted); font-size:22rpx; }
.text-link { padding:10rpx 0; color:var(--primary); font-size:23rpx; }

.notice { margin-bottom:20rpx; padding:18rpx 22rpx; border-radius:16rpx; background:#f2e7dc; color:#8a5b3f; font-size:23rpx; }
.empty-state { display:flex; min-height:280rpx; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; color:var(--muted); font-size:24rpx; text-align:center; }

.btn-primary { width:100%; height:96rpx; margin:0; border-radius:999rpx; background:var(--primary); color:#fff; font-size:28rpx; font-weight:600; line-height:96rpx; }
.btn-outline { width:100%; height:88rpx; border:1rpx solid var(--primary); border-radius:999rpx; background:transparent; color:var(--primary); font-size:26rpx; line-height:86rpx; }
