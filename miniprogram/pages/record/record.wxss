.record-page .page-head { margin-bottom:22rpx; } .entry-card { padding:28rpx; } .record-header { display:flex; align-items:center; justify-content:space-between; padding-bottom:20rpx; border-bottom:1rpx solid var(--line); } .record-date { padding:10rpx 0; color:var(--text); font-size:24rpx; }
.weight-input-area { padding:40rpx 0 26rpx; text-align:center; } .weight-input-wrapper { display:flex; align-items:baseline; justify-content:center; gap:0; } .weight-input { height:110rpx; color:var(--figure); font-size:88rpx; line-height:110rpx; text-align:center; } .weight-input-unit { color:var(--text-soft); font-weight:600; } .weight-hint { display:block; margin-top:14rpx; color:var(--muted); font-size:20rpx; }
.quick-weights { display:flex; justify-content:center; gap:10rpx; } .quick-weight-btn { padding:12rpx 25rpx; border:1rpx solid var(--line); border-radius:12rpx; color:var(--muted); font-size:24rpx; } .quick-weight-btn.selected { border-color:#9eb29b; background:var(--primary-soft); color:var(--primary); }
.weight-compare { margin-top:18rpx; color:var(--muted); font-size:22rpx; text-align:center; } .note-input-area { margin:32rpx 0 24rpx; } .note-input { width:100%; height:76rpx; margin-top:10rpx; padding:0 16rpx; border-radius:12rpx; background:#f1f1e9; font-size:23rpx; } .record-tip { margin:18rpx 8rpx; color:var(--muted); font-size:22rpx; line-height:1.7; }
.share-overlay { position:fixed; inset:0; z-index:100; display:flex; align-items:center; justify-content:center; padding:34rpx; background:#173b2bcc; } .share-card { width:100%; padding:40rpx 30rpx 24rpx; border-radius:25rpx; background:var(--surface); text-align:center; } .success-mark { width:68rpx; height:68rpx; margin:0 auto 18rpx; border-radius:50%; background:var(--primary-soft); color:var(--primary); font-size:38rpx; line-height:68rpx; } .share-title { display:block; color:var(--text); font-size:32rpx; font-weight:600; } .share-weight { display:block; margin-top:18rpx; color:var(--figure); font-size:72rpx; } .share-unit { color:var(--muted); font-weight:500; } .share-date,.share-msg { display:block; color:var(--muted); font-size:22rpx; } .share-msg { margin:18rpx 0 28rpx; } .share-skip { margin-top:10rpx; background:transparent; color:var(--muted); font-size:22rpx; }
