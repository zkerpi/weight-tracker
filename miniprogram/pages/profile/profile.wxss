/* 我的页 —— 对齐设计稿：全幅照片头图 + 悬浮照片的菜单卡 */

.profile-page { padding:0 0 calc(150rpx + env(safe-area-inset-bottom)); }

/* 头图 */
.profile-hero {
  position:relative; display:flex; height:448rpx; align-items:flex-end;
  padding:0 40rpx 104rpx; overflow:hidden;
}
.profile-hero-image { position:absolute; inset:0; width:100%; height:100%; }
.profile-hero-wash {
  position:absolute; inset:0;
  background:linear-gradient(180deg, rgba(20,28,22,.20) 0%, rgba(20,28,22,.02) 22%, rgba(20,28,22,.16) 52%, rgba(20,28,22,.54) 78%, rgba(20,28,22,.70) 100%);
}
.profile-hero-body { position:relative; z-index:1; display:flex; width:100%; align-items:center; }

.avatar-btn {
  position:relative; flex-shrink:0; width:132rpx; height:132rpx; margin:0; padding:0;
  border-radius:50%; background:transparent; line-height:normal;
}
.avatar-btn::after { border:none; }
.profile-avatar { width:132rpx; height:132rpx; border:4rpx solid rgba(255,255,255,.92); border-radius:50%; }

.profile-meta { display:flex; flex:1; min-width:0; flex-direction:column; margin-left:24rpx; }
.profile-name {
  overflow:hidden; color:#fff; font-family:"Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", Georgia, serif;
  font-size:46rpx; font-weight:400; letter-spacing:1rpx; line-height:1.25;
  text-overflow:ellipsis; white-space:nowrap;
  text-shadow:0 2rpx 14rpx rgba(16,24,18,.45);
}
.profile-sub { margin-top:6rpx; color:rgba(255,255,255,.92); font-size:24rpx; letter-spacing:.5rpx; text-shadow:0 2rpx 10rpx rgba(16,24,18,.45); }
.profile-edit {
  flex-shrink:0; align-self:center; padding:10rpx 24rpx; border-radius:999rpx;
  background:rgba(255,255,255,.24); color:#fff; font-size:23rpx; line-height:1.2;
  text-shadow:0 2rpx 8rpx rgba(16,24,18,.35);
}

/* 昵称编辑 */
.profile-editor { margin:24rpx 40rpx 0; padding:24rpx; border-radius:22rpx; }
.editor-label { display:block; margin-bottom:10rpx; color:var(--muted); font-size:22rpx; }
.profile-name-input { width:100%; height:80rpx; padding:0 22rpx; border:1rpx solid var(--line); border-radius:18rpx; background:#f5f2e9; font-size:27rpx; }
.editor-actions { display:flex; gap:14rpx; margin-top:18rpx; }
.editor-cancel,.editor-save { flex:1; height:80rpx; margin:0; border-radius:999rpx; font-size:25rpx; line-height:80rpx; }
.editor-cancel { background:var(--surface-soft); color:var(--muted); }
.editor-save { background:var(--primary); color:#fff; }

/* 菜单卡：设计稿里像一张浮在照片上的白色圆角卡 */
.menu-card {
  position:relative; z-index:2; margin:-52rpx 32rpx 0; padding:8rpx 26rpx;
  border-radius:28rpx; background:var(--surface); box-shadow:0 18rpx 44rpx rgba(60,66,52,.10);
}
.menu-row { display:flex; align-items:center; min-height:112rpx; border-bottom:1rpx solid #efebe0; }
.menu-row-last { border-bottom:none; }
.menu-icon { width:44rpx; height:44rpx; margin-right:20rpx; }
.menu-title { flex:1; color:var(--text); font-size:28rpx; }
.menu-value { max-width:300rpx; overflow:hidden; color:var(--muted); font-size:25rpx; text-overflow:ellipsis; white-space:nowrap; }
.menu-arrow { margin-left:10rpx; color:var(--faint); font-size:30rpx; }

.profile-footnote { display:block; margin:56rpx 40rpx 0; color:var(--faint); font-size:21rpx; letter-spacing:.5rpx; text-align:center; }
