<view class="page profile-page">
  <view class="profile-hero">
    <image class="profile-hero-image" src="/images/cat-hero.jpg" mode="aspectFill"></image>
    <view class="profile-hero-wash"></view>
    <view class="profile-hero-body">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="profile-avatar" src="{{avatarUrl || '/images/cat-avatar.jpg'}}" mode="aspectFill"></image>
      </button>
      <view class="profile-meta">
        <text class="profile-name">{{nickName || '小禾'}}</text>
        <text class="profile-sub">见证一个更轻盈的自己</text>
      </view>
      <text class="profile-edit" bindtap="startEditProfile">编辑</text>
    </view>
  </view>

  <view class="card profile-editor" wx:if="{{editingProfile}}">
    <text class="editor-label">昵称</text>
    <input type="nickname" maxlength="20" class="profile-name-input" placeholder="输入你的昵称" value="{{nickName}}" bindinput="onNicknameInput" focus="{{true}}" />
    <view class="editor-actions">
      <button class="editor-cancel" bindtap="cancelEditProfile">取消</button>
      <button class="editor-save" bindtap="saveProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}">保存</button>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-row" bindtap="goGoal">
      <image class="menu-icon" src="/images/ui-goal.png"></image>
      <text class="menu-title">目标体重</text>
      <text class="menu-value">{{hasGoal ? goalTarget + ' ' + unitLabel : '未设置'}}</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-row" bindtap="goUnit">
      <image class="menu-icon" src="/images/ui-unit.png"></image>
      <text class="menu-title">体重单位</text>
      <text class="menu-value">{{unitLabel}}</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-row menu-row-last" bindtap="goGroups">
      <image class="menu-icon" src="/images/ui-group.png"></image>
      <text class="menu-title">所属小组</text>
      <text class="menu-value">{{groupCount > 0 ? groupCount + ' 个' : '未加入'}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <text class="profile-footnote">每一个数字，都只是了解自己的方式。</text>
</view>
