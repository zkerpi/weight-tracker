<view class="page">
  <view class="page-head">
    <view class="page-head-copy">
      <text class="display-title">趋势</text>
      <text class="page-tagline">用一段时间的变化，了解自己的节奏</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="notice" bindtap="retry">{{error}} ↗</view>

  <!-- 趋势：卡片里只留三样——区间、曲线、一行注脚。
       原来还有「体重趋势」小标题 + 五个带底的胶囊 + 三个 40rpx 大数字 + 提示语，
       一屏里五个视觉焦点互相争，挤。 -->
  <view class="card trend-card">
    <view class="range-tabs">
      <view wx:for="{{chartRanges}}" wx:key="*this"
            class="range-tab {{chartRangeIndex === index ? 'active' : ''}}"
            bindtap="onChartRangeChange" data-index="{{index}}">{{item}}</view>
    </view>
    <view wx:if="{{chartError}}" class="trend-empty" bindtap="loadChart">{{chartError}}</view>
    <view wx:elif="{{chartLoading}}" class="trend-empty">正在整理趋势…</view>
    <trend-chart wx:elif="{{hasChartData}}" data="{{chartData}}" goalWeight="{{goalWeight}}"
                 unitLabel="{{unitLabel}}" goalType="{{goalType}}" height="300"></trend-chart>
    <view wx:else class="trend-empty">记录两次以后，曲线才会出现</view>
    <view class="trend-note tabular" wx:if="{{!chartLoading && !chartError}}">
      <text>均值 <text class="fig-inline">{{periodAverage}}</text> {{unitLabel}}</text>
      <text class="trend-note-dot">·</text>
      <text>首末 <text class="fig-inline">{{periodChange}}</text></text>
      <text class="trend-note-dot">·</text>
      <text>{{periodCount || 0}} 次记录</text>
    </view>
  </view>

  <view class="list-head">
    <text class="section-title">记录明细</text>
    <text class="text-link" bindtap="goRecord">补记 / 新增 ›</text>
  </view>

  <!-- 补签：原来是一块带标题和列表的横幅，占掉整屏的 1/6；
       改成一行，日期做成可点的小块 -->
  <view wx:if="{{gaps.length > 0}}" class="gap-line">
    <text class="gap-label">可补记</text>
    <view class="gap-chips">
      <text class="gap-chip" wx:for="{{gaps}}" wx:key="date"
            bindtap="goBackfill" data-date="{{item.date}}">{{item.label}}</text>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="rec-card">
    <view class="skeleton-row" wx:for="{{5}}" wx:key="*this">
      <view class="skeleton-line skeleton-day"></view>
      <view class="skeleton-line skeleton-note"></view>
      <view class="skeleton-line skeleton-weight"></view>
    </view>
  </view>

  <block wx:else>
    <view wx:if="{{groups.length > 0}}" class="rec-card">
      <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
        <view class="rec-month {{index > 0 ? 'is-after' : ''}}">{{group.label}}</view>
        <view class="rec-row {{rec.first ? 'is-first' : ''}}" wx:for="{{group.items}}" wx:key="_id" wx:for-item="rec"
              data-id="{{rec._id}}" data-date="{{rec.date}}"
              bindtap="goBackfill" bindlongpress="onDeleteRecord">
          <view class="rec-day">
            <text class="rec-day-num tabular">{{rec.day}}</text>
            <text class="rec-week">{{rec.week}}</text>
          </view>
          <text class="rec-note">{{rec.note}}</text>
          <view class="rec-fig">
            <view class="fig-row">
              <text class="fig-num">{{rec.weight}}</text>
              <text class="fig-unit">{{unitLabel}}</text>
            </view>
            <text class="rec-delta tabular {{rec.diffUp ? 'is-up' : ''}} {{rec.diffDown ? 'is-down' : ''}}">{{rec.diffFormatted}}</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="empty-state">
      <text>还没有留下记录</text>
      <text>记下今天，回看时会感谢自己</text>
    </view>
  </block>

  <view class="list-foot" wx:if="{{!loading && groups.length > 0}}">
    {{loadingMore ? '正在加载…' : (hasMore ? '上拉加载更早的记录' : '已到最早的一条')}}<text wx:if="{{!hasMore}}" class="list-foot-hint">· 长按记录可删除</text>
  </view>
</view>
