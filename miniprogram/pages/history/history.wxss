/* 趋势页 —— 与其它页同一套标题与数字：衬线大标题 + 衬线粗体数字 */

/* 区间统计：三个数字是这页的主角，40rpx 衬线粗体 */
.period-stats { display:flex; padding:4rpx 0 22rpx; border-bottom:1rpx solid var(--line); }
.period-stats>view { flex:1; }
.period-value { display:block; font-size:40rpx; }
.period-label { display:block; margin-top:8rpx; color:var(--muted); font-size:19rpx; }

.history-trend { padding:26rpx 24rpx 24rpx; }
.range-tabs { display:flex; gap:5rpx; margin:22rpx 0 18rpx; padding:5rpx; border-radius:13rpx; background:var(--surface-soft); }
.range-tab { flex:1; padding:11rpx 0; border-radius:9rpx; color:var(--muted); font-size:22rpx; text-align:center; }
.range-tab.active { background:var(--surface); color:var(--text); font-weight:600; box-shadow:0 3rpx 10rpx #20372d0f; }

.history-list-heading { margin:30rpx 4rpx 14rpx; }
.backfill-banner { margin-bottom:18rpx; padding:18rpx 20rpx; border-radius:16rpx; background:#eeeade; }
.backfill-title { display:block; color:var(--text); font-size:23rpx; font-weight:600; }
.backfill-list { display:flex; flex-direction:column; gap:7rpx; margin-top:10rpx; }
.backfill-item { display:flex; justify-content:space-between; padding:10rpx 12rpx; border-radius:9rpx; background:#fff8; color:var(--muted); font-size:22rpx; }
.backfill-action { color:var(--primary); }

.history-list { overflow:hidden; border:1rpx solid var(--line); border-radius:20rpx; background:var(--surface); }
.history-item { display:flex; align-items:center; justify-content:space-between; min-height:116rpx; padding:20rpx 24rpx; border-bottom:1rpx solid var(--line); }
.history-item:last-child { border-bottom:none; }
.history-left { display:flex; min-width:0; flex-direction:column; gap:5rpx; }
.history-date { color:var(--text); font-size:25rpx; font-weight:600; }
.history-note { max-width:310rpx; overflow:hidden; color:var(--muted); font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }
.history-right { display:flex; align-items:flex-end; flex-direction:column; gap:4rpx; }
.history-weight { font-size:34rpx; }
.history-diff { color:var(--muted); font-size:20rpx; }
.diff-up { color:#9c6349; }
.diff-down { color:#4d7a5c; }
.delete-action { padding:5rpx 0 0 18rpx; color:var(--faint); font-size:19rpx; }
.load-more { padding:22rpx; color:var(--muted); font-size:20rpx; text-align:center; }

/* 骨架屏 */
.skeleton-list { padding-top:8rpx; }
.skeleton-item { display:flex; align-items:center; justify-content:space-between; height:116rpx; padding:0 24rpx; border-bottom:1rpx solid var(--line); }
.skeleton-line { height:18rpx; border-radius:9rpx; background:#eae6da; }
.skeleton-date { width:180rpx; }
.skeleton-weight { width:120rpx; }
.skeleton-change { width:90rpx; }
