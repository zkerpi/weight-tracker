/* 排行榜 —— 领奖台 + 榜单，与「动态」列表刻意区分开 */

.rank-page { padding:12rpx 40rpx calc(300rpx + env(safe-area-inset-bottom)); }

/* 顶部 */
.rank-head { align-items:flex-start; }
.rank-tagline { max-width:420rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.rank-invite { width:64rpx; height:64rpx; margin:0; padding:0; border-radius:50%; background:transparent; line-height:normal; }
.rank-invite-icon { width:48rpx; height:48rpx; margin:10rpx 0 0 8rpx; }

/* 多群组切换 */
.group-scroll { display:flex; margin-top:18rpx; white-space:nowrap; }
.group-chip {
  display:inline-flex; flex-shrink:0; height:56rpx; margin-right:12rpx; padding:0 24rpx;
  align-items:center; border-radius:999rpx; background:#e9e6db; color:#6f766e; font-size:23rpx;
}
.group-chip.active { background:var(--primary); color:#fff; font-weight:600; }

/* 指标切换 */
.metric-tabs { display:flex; height:76rpx; margin-top:18rpx; padding:5rpx; border-radius:999rpx; background:#e9e6db; }
.metric-tab {
  display:flex; flex:1; align-items:center; justify-content:center;
  border-radius:999rpx; color:#6f766e; font-size:25rpx;
}
.metric-tab.active { background:#fbf9f3; color:var(--primary); font-weight:650; }

/* 面板 */
.rank-panel {
  margin-top:22rpx; padding:26rpx 26rpx 8rpx;
  border:1rpx solid var(--line); border-radius:26rpx; background:var(--surface);
}

/* 领奖台 */
.podium { display:flex; align-items:flex-end; }
.podium-col { display:flex; flex:1; min-width:0; flex-direction:column; align-items:center; }
.podium-avatar-wrap {
  position:relative; display:flex; width:112rpx; height:112rpx; align-items:center; justify-content:center;
  border-radius:50%; background:#eeeade;
}
.place-1 .podium-avatar-wrap {
  width:136rpx; height:136rpx;
  background:linear-gradient(150deg, #e9dcc0 0%, #d8c59b 100%);
}
.podium-avatar { width:100%; height:100%; border-radius:50%; background:#e9e6db; border:5rpx solid #fbf9f3; }
.podium-avatar-wrap.empty { background:#f1eee4; border:1rpx dashed #ddd7c7; }
.podium-badge {
  position:absolute; right:-6rpx; bottom:-6rpx; display:flex; width:38rpx; height:38rpx;
  align-items:center; justify-content:center; border-radius:50%;
  background:var(--primary); border:3rpx solid #fbf9f3;
}
.podium-badge-text { color:#fff; font-size:20rpx; line-height:1; }
.podium-name {
  max-width:190rpx; margin-top:12rpx; overflow:hidden;
  color:var(--text); font-size:23rpx; text-align:center; text-overflow:ellipsis; white-space:nowrap;
}
.podium-name.faint { color:var(--faint); }
/* 名次数字统一走全站 fig 系统：容器给字号，数字 1em、单位 .34em */
.podium-value { margin-top:8rpx; font-size:40rpx; }
.podium-num.faint { color:#c9c4b5; }
.podium-block {
  display:flex; width:100%; margin-top:14rpx; padding-top:12rpx;
  align-items:flex-start; justify-content:center;
  border-radius:16rpx 16rpx 0 0; background:#f1eee4;
}
.place-1 .podium-block { height:92rpx; background:#e5ecdf; }
.place-2 .podium-block { height:70rpx; background:#eeeade; }
.place-3 .podium-block { height:56rpx; background:#f1eee4; }
.podium-block.empty { background:#f5f2e9; }
.podium-rank { color:var(--primary); font-size:32rpx; }

/* 榜单 */
.board { margin-top:18rpx; }
.board-row { display:flex; align-items:center; padding:18rpx 0; border-top:1rpx solid #efebe0; }
.board-row.is-me { margin:0 -10rpx; padding:18rpx 10rpx; border-radius:16rpx; background:var(--primary-soft); }
.board-rank { width:44rpx; flex-shrink:0; color:var(--muted); font-size:23rpx; text-align:center; }
.board-avatar { width:60rpx; height:60rpx; flex-shrink:0; border-radius:50%; background:#e9e6db; }
.board-copy { display:flex; flex:1; min-width:0; flex-direction:column; margin-left:16rpx; }
.board-name-line { display:flex; align-items:center; }
.board-name { max-width:250rpx; overflow:hidden; color:var(--text); font-size:26rpx; text-overflow:ellipsis; white-space:nowrap; }
.board-me {
  margin-left:10rpx; padding:0 10rpx; border-radius:8rpx;
  background:var(--primary); color:#fff; font-size:18rpx; line-height:1.7;
}
.board-sub { margin-top:3rpx; color:var(--muted); font-size:20rpx; }
.board-value { flex-shrink:0; margin-left:12rpx; font-size:32rpx; }
.board-idle { display:block; padding:16rpx 0 12rpx; color:var(--faint); font-size:20rpx; text-align:center; }

/* 指标值的语义色：减重为正=绿，增重=橙 */
.good { color:#3d6a4c; }
.warn { color:#b4765a; }
.flat { color:var(--text); }

/* 空状态 */
.rank-empty { display:flex; min-height:520rpx; flex-direction:column; align-items:center; justify-content:center; }
.rank-empty-mark { color:#cdc7b6; font-size:40rpx; }
.rank-empty-title { margin-top:12rpx; color:var(--text); font-size:30rpx; }
.rank-empty-note { margin-top:8rpx; color:var(--muted); font-size:23rpx; text-align:center; }
.rank-empty-cta { width:400rpx; margin-top:36rpx; }

/* 我的排名（贴底） */
.my-bar {
  position:fixed; left:24rpx; right:24rpx; bottom:calc(24rpx + env(safe-area-inset-bottom));
  display:flex; min-height:104rpx; padding:16rpx 26rpx; align-items:center;
  border-radius:26rpx; background:rgba(38,64,47,.97);
  box-shadow:0 14rpx 34rpx rgba(28,36,30,.26);
}
.my-bar-rank {
  min-width:52rpx; color:#e7ede1; font-size:32rpx; text-align:center; line-height:1;
}
.my-bar-avatar { width:56rpx; height:56rpx; margin-left:8rpx; border-radius:50%; background:#3a5747; }
.my-bar-copy { display:flex; flex:1; min-width:0; flex-direction:column; margin-left:16rpx; }
.my-bar-name { overflow:hidden; color:#fff; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }
.my-bar-sub { margin-top:2rpx; color:rgba(255,255,255,.66); font-size:19rpx; }
.my-bar-value { flex-shrink:0; font-size:36rpx; }
.my-bar-num { color:#fff; }
.my-bar-unit { color:rgba(255,255,255,.74); }
.my-bar-cta {
  flex-shrink:0; padding:10rpx 24rpx; border-radius:999rpx;
  background:#fbf9f3; color:var(--primary); font-size:22rpx; font-weight:600;
}

/* 骨架屏 */
.skeleton-avatar { border-radius:50%; background:#eeeade; }
.skeleton-avatar.big { width:96rpx; height:96rpx; }
.skeleton-avatar.huge { width:120rpx; height:120rpx; }
.skeleton-line { height:16rpx; margin-top:14rpx; border-radius:8rpx; background:#eeeade; }
.skeleton-line.w60 { width:60%; }
