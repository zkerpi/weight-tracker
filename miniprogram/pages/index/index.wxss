/* 今日页 —— 一屏装下三块内容（圆环 / 按钮 / 两个面板）

   圆环是页面的主角，白天是太阳、夜里是月亮：
   - 太阳：暖金描边 + 外圈 12 道光芒（12 个 .ray 绕圆心旋转，30° 一档）
   - 月亮：冷灰描边 + 内侧向下的阴影（月相明暗交界）+ 9 颗星点
   圆环内是三段式节奏：标签（26rpx）→ 体重（运行时反算字号）→ 涨跌胶囊，
   胶囊用绝对定位沉在圆环底部，所以有没有涨跌数据，数字的位置都不动。 */

.home-page { padding:12rpx 40rpx calc(34rpx + env(safe-area-inset-bottom)); }

/* 顶部标题区 */
.home-head { align-items:flex-start; }
.home-date { padding-top:22rpx; color:var(--muted); font-size:22rpx; letter-spacing:.5rpx; white-space:nowrap; }

/* ---------------- 圆环 ---------------- */
.weight-stage { position:relative; margin-top:44rpx; }
.weight-ring {
  position:relative; display:flex; width:400rpx; height:400rpx; margin:0 auto;
  flex-direction:column; align-items:center; justify-content:center;
  padding-bottom:48rpx; border-radius:50%;
  transition:background .5s ease, border-color .5s ease, box-shadow .5s ease;
}
/* 白天：太阳 —— 暖金描边 + 米白偏暖的盘面 */
.weight-ring.is-day {
  border:3rpx solid rgba(206,158,82,.55);
  background:radial-gradient(circle at 50% 32%, #fffdf7 0%, #fdf7e7 56%, #f8eed7 100%);
  box-shadow:0 0 66rpx rgba(214,172,96,.22), 0 14rpx 32rpx rgba(148,122,68,.08);
}
/* 夜里：月亮 —— 盘面是夜空本身，数字翻成暖白；
   光源在左上，右下压一层冷影当明暗交界 */
.weight-ring.is-night {
  border:2rpx solid rgba(238,231,208,.30);
  background:radial-gradient(circle at 36% 26%, #2b3a31 0%, #22302a 46%, #182019 100%);
  box-shadow:inset -26rpx -20rpx 56rpx rgba(8,14,10,.55),
             0 0 64rpx rgba(126,148,132,.30), 0 16rpx 34rpx rgba(24,34,28,.22);
}
.is-night .ring-caption { color:rgba(238,232,210,.66); }
.is-night .ring-number { color:#f7f2e3; }
.is-night .ring-unit { color:rgba(247,242,227,.82); }
.is-night .ring-chip { background:rgba(255,255,255,.13); color:#e2ead9; }
.is-night .ring-chip.up { background:rgba(206,150,116,.22); color:#f0c9b2; }
.is-night .ring-chip.flat { background:rgba(255,255,255,.09); color:rgba(238,232,210,.7); }
.is-night .ring-hint { color:rgba(238,232,210,.6); }

/* 太阳光芒：以圆心为旋转原点，落在圆环外侧 8~40rpx 的环带上 */
.ring-rays { position:absolute; left:50%; top:50%; width:0; height:0; pointer-events:none; }
.ray {
  position:absolute; left:-2rpx; top:-238rpx; width:4rpx; height:30rpx;
  border-radius:4rpx; transform-origin:50% 238rpx;
  background:linear-gradient(180deg, rgba(200,152,72,.10) 0%, rgba(200,152,72,.85) 100%);
}
.ray:nth-child(even) { opacity:.5; }

/* 星点：只出现在夜空里 */
.ring-stars { position:absolute; left:0; top:0; width:400rpx; height:400rpx; pointer-events:none; }
.star { position:absolute; border-radius:50%; background:#fdf8e6; box-shadow:0 0 10rpx rgba(255,250,226,.85); }

/* 夜空里的月牙：实心圆 + 一个同色于夜空的偏心圆「咬」出缺口 */
.ring-moon {
  position:absolute; left:196rpx; top:56rpx;
  width:36rpx; height:36rpx; border-radius:50%; background:#f4ebc9;
  box-shadow:0 0 20rpx rgba(244,235,201,.55);
  overflow:hidden;
}
.ring-moon::after {
  content:''; position:absolute; left:12rpx; top:-5rpx;
  width:34rpx; height:34rpx; border-radius:50%; background:#28362d;
}

/* 标签：字距放大当「小标」用，末尾补一个字距让视觉居中 */
.ring-caption {
  margin-left:7rpx; color:#78806f; font-size:26rpx; font-weight:500;
  letter-spacing:7rpx; line-height:1; text-align:center;
}
/* 体重：字号由 index.js 按字符宽度反算后内联写入，这里是 1em 的基准 */
.ring-figure { display:flex; margin-top:18rpx; align-items:baseline; justify-content:center; }
.ring-number { color:var(--figure); font-size:1em; line-height:1; }
.ring-unit { margin-left:9rpx; color:#3f4e3d; font-size:.34em; font-weight:600; }

/* 涨跌胶囊：沉在圆环底部，位置与有无数据无关 */
.ring-chip {
  position:absolute; left:50%; bottom:60rpx; transform:translateX(-50%);
  display:flex; height:44rpx; padding:0 22rpx; align-items:center;
  border-radius:999rpx; background:#eaeede; color:#4a6653;
  font-size:20rpx; letter-spacing:.5rpx; white-space:nowrap;
}
.ring-chip.up { background:#f4e7dd; color:#9c6349; }
.ring-chip.flat { background:#eceae0; color:#8a9086; }

.ring-hint { display:block; margin-top:18rpx; color:var(--muted); font-size:21rpx; text-align:center; }

/* ---------------- 主按钮 ---------------- */
.primary-pill {
  display:flex; align-items:center; justify-content:center; width:100%; height:88rpx; margin:34rpx 0 0;
  border-radius:999rpx; background:var(--primary); color:#fff;
  box-shadow:0 12rpx 26rpx rgba(47,75,57,.16);
}
.pill-plus {
  display:flex; width:46rpx; height:46rpx; margin-right:16rpx; align-items:center; justify-content:center;
  border-radius:50%; background:#fff; color:var(--primary); font-size:30rpx; font-weight:300; line-height:1;
}
.pill-label { font-size:28rpx; font-weight:600; letter-spacing:.5rpx; }

/* ---------------- 面板 ---------------- */
.panel {
  margin:16rpx -16rpx 0; padding:20rpx 28rpx;
  border:1rpx solid #e8e3d5; border-radius:24rpx; background:#f8f6ee;
}
.panel-muted { background:#f4f1e6; }
.panel-head { display:flex; align-items:center; justify-content:space-between; }
.panel-title { color:var(--text); font-size:26rpx; font-weight:650; }
/* 面板右上角的静态计数（本周打卡的 3 / 7 天）：纯文字，不可点 */
.panel-stat { color:var(--muted); font-size:21rpx; }
/* 面板右上角的动作（体重趋势的「近7天」）：原来和上面的计数共用一套灰小字，
   于是链接长得像图注、点按高度不足半个字；改为有底的胶囊 + 自绘箭头。 */
.panel-action {
  display:flex; height:44rpx; padding:0 18rpx 0 16rpx;
  align-items:center; border-radius:999rpx; background:#eae6d6;
}
.panel-action-hover { background:#e0dbc7; }
.panel-action-text { color:var(--primary); font-size:21rpx; font-weight:600; letter-spacing:.6rpx; line-height:1; }
/* 箭头用两条边框旋转 45° 画，不吃字体差异：› 在中文字体里位置随字库漂移 */
.panel-action-arrow {
  width:8rpx; height:8rpx; margin-left:5rpx;
  border-top:2rpx solid var(--primary); border-right:2rpx solid var(--primary);
  transform:translateY(-1rpx) rotate(45deg);
}

/* 本周打卡 */
.week-row { display:flex; margin-top:14rpx; }
.week-cell { display:flex; flex:1; flex-direction:column; align-items:center; }
.week-label { color:var(--muted); font-size:19rpx; line-height:1.2; }
.week-label.is-today { color:var(--primary); font-weight:650; }
/* 还没到的日子：淡到只剩位置。不下虚线框、不做灰色实心点——
   那是「待完成」的形状，周中打开会像欠着四天的账。 */
.week-label.is-future { opacity:.34; }
.week-dot {
  display:flex; width:40rpx; height:40rpx; margin-top:10rpx; align-items:center; justify-content:center;
  border-radius:50%; background:#e9e5d8;
}
.week-dot.future { background:#f4f1e8; }
.week-dot.done { background:var(--primary); }
.week-tick { color:#fff; font-size:21rpx; line-height:1; }

/* 趋势 */
.chart-placeholder { display:flex; min-height:170rpx; flex-direction:column; align-items:center; justify-content:center; color:var(--muted); font-size:21rpx; text-align:center; }
.chart-placeholder-title { margin-bottom:6rpx; color:var(--text); font-size:24rpx; }
.chart-placeholder-note { color:var(--faint); font-size:19rpx; }
